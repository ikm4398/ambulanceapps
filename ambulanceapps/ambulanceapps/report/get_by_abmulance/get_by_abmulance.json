 "prepared_report": 0,
 "query": "SELECT \r\n    p.custom_ambulance_,\r\n    \r\n    COUNT(*) AS patient_count,\r\n    a.driver_name,\r\n    a.address_line\r\nFROM \r\n    `tabPatient` p\r\nLEFT JOIN \r\n    `tabNew Ambulance` a \r\n    ON p.custom_ambulance_ = a.name\r\nWHERE \r\n    p.custom_admit_date BETWEEN %(from_date)s AND %(to_date)s \r\n    AND p.custom_ambulance_ = %(amb_name)s\r\nGROUP BY \r\n    p.custom_ambulance_, a.driver_name, a.address_line;\r\n",
